# Copier vers .env. Pour une installation neuve, générer trois valeurs
# distinctes avec openssl rand -hex 32 et renseigner les champs ci-dessous.
# Sur une installation existante, conserver les identifiants et clés actuels.
DB_PASSWORD=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

DB_NAME=erp_db
DB_USER=postgres

# URL exacte ouverte dans le navigateur, sans slash final.
# En ligne, utiliser par exemple https://erp.example.com.
CLIENT_ORIGIN=http://localhost:4000
# Pour un reverse proxy installé sur le même hôte, conserver 127.0.0.1.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=4000

JWT_EXPIRES=7d
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_DAYS=7
JSON_BODY_LIMIT=50mb
LOG_LEVEL=info

# Clés facultatives pour les intégrations.
STEAM_API_KEY=
ITAD_API_KEY=

# Hors Docker uniquement, adapter ces valeurs au PostgreSQL local.
# DB_HOST=localhost
# DB_PORT=5432
