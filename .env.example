# PostgreSQL Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_db

# Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Origines CORS autorisées (liste séparée par des virgules).
# Pour accéder depuis d'autres PC du réseau, ajoutez leurs origines, ex :
# CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173,http://poste2.local:4000
# Une entrée peut aussi être un simple hostname/IP (tous ports/protocoles acceptés pour cet hôte), ex :
# CORS_ORIGINS=192.168.1.20,poste2.local
# Si non défini, retombe sur CLIENT_ORIGIN.
CORS_ORIGINS=
JWT_SECRET=replace-with-a-strong-random-secret
# Clé dédiée au chiffrement AES-256-GCM des champs password
FIELD_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

ITAD_API_KEY=votrecle
